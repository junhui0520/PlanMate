# ── 서버(backend) ──
# 오라클 DB 주소 (공용 DB면 그 컴퓨터 주소, 내 컴퓨터면 localhost)
DB_URL=jdbc:oracle:thin:@<DB주소>:1521/<DB이름>
DB_USERNAME=<DB아이디>
DB_PASSWORD=<DB비밀번호>

# [A 파트] 인증번호 CODE_HMAC 비밀키
EMAIL_VERIFICATION_HMAC_SECRET=<긴비밀문자열>
# [A 파트] 초대 링크 TOKEN_CIPHERTEXT 암호화 키
INVITE_TOKEN_SECRET=<긴비밀문자열>
# [A 파트] 소셜 로그인 (카카오·네이버·구글·Apple, 키 발급 후 채움)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# [A 파트] 인증번호 발송용 메일 (외부 메일 제공자 확정 후 채움)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# [C 파트] AI 추천 및 지도·장소 검색 서버용 키
AI_API_KEY=<AI서비스키>
MAP_API_KEY=<지도서버용키>

# [D 파트] 한국수출입은행 환율 키
EXCHANGE_API_KEY=<환율키>

# 세션 쿠키 Secure 여부 (비워 두면 false = 로컬 HTTP 테스트용, 운영 배포 시 true)
COOKIE_SECURE=
# 화면이 켜지는 주소
FRONTEND_URL=http://localhost:5173

# ── 화면(frontend) ──
VITE_API_BASE_URL=http://localhost:8080
VITE_MAP_JS_KEY=<지도화면용키>